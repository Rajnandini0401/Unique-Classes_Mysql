# Server Configuration
PORT=5000

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tuition_db

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Credentials (Optional / Development Seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# WhatsApp Integration (Meta Cloud API - Optional)
WHATSAPP_CLOUD_API_TOKEN=your_meta_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# WhatsApp Integration (UltraMsg - Optional)
ULTRAMSG_INSTANCE_ID=your_ultramsg_instance_id_here
ULTRAMSG_TOKEN=your_ultramsg_token_here
